{{ define "main" }}
<main class="section">
  <div class="site-shell article-layout">
    <article class="article">
      <div class="kicker">{{ .Kicker }}</div>
      <h1 class="article-title">{{ .Title }}</h1>
      <div class="article-content">{{ .Content }}</div>
    </article>
  </div>
</main>
{{ end }}
